/* ASUS Dashboard style.
   Words like @TEXT@ are placeholders. The colours behind them are in themes.py, one set per
   theme, and dashboard.py swaps them in when it loads this file. @ASSETS@ becomes the path
   of the assets folder. Change colours in themes.py; change shapes and sizes here. */

/* ---------- Window: a see-through dark tint over the desktop ---------- */
QWidget#window {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 @WINDOW_TOP@, stop:1 @WINDOW_BOTTOM@);
}

/* ---------- Text ---------- */
QLabel {
    color: @TEXT@;
    font-size: 14px;
    background: transparent;
}

QLabel#title {
    font-size: 22px;
    font-weight: 600;
    padding: 4px 0 6px 0;
}

QLabel#status, QLabel#themeLabel {
    color: @MUTED@;
    font-size: 13px;
}

/* ---------- Sections: flat cards with a coloured line along the bottom ---------- */
QGroupBox {
    background: @CARD@;
    border: 1px solid @CARD_BORDER@;
    border-bottom: 2px solid @ACCENT@;
    border-radius: 12px;
    margin-top: 30px;
    padding: 14px 14px 12px 14px;
    color: @TEXT@;
    font-size: 16px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 4px;
    top: 4px;
}

QGroupBox#performance { border-bottom-color: @SECTION_1@; }
QGroupBox#display     { border-bottom-color: @SECTION_2@; }
QGroupBox#keyboard    { border-bottom-color: @SECTION_3@; }
QGroupBox#battery     { border-bottom-color: @SECTION_4@; }

/* ---------- Buttons ---------- */
QPushButton {
    background: @INPUT@;
    color: @TEXT@;
    border: 1px solid @CARD_BORDER@;
    border-radius: 9px;
    padding: 7px 16px;
    font-size: 14px;
}

QPushButton:hover {
    border-color: @ACCENT@;
}

QPushButton:pressed {
    background: @ACCENT_DARK@;
}

QPushButton:disabled {
    color: rgba(255, 255, 255, 0.3);
}

/* ---------- The Profile row at the top: the main one-click choice ---------- */
QLabel#presetLabel {
    font-size: 15px;
    font-weight: 600;
}

QLabel#presetHint {
    color: @MUTED@;
    font-size: 13px;
    padding-left: 6px;
}

/* ---------- Dropdowns, and the list that pops up ---------- */
QComboBox {
    background: @INPUT@;
    color: @TEXT@;
    border: 1px solid @CARD_BORDER@;
    border-radius: 9px;
    padding: 6px 12px;
    font-size: 14px;
    min-width: 150px;
}

QComboBox#presetBox {
    min-width: 170px;
    font-size: 15px;
    font-weight: 600;
    border: 1px solid @ACCENT_DARK@;
}

QComboBox#themeBox {
    min-width: 90px;
    padding: 5px 10px;
    font-size: 13px;
}

QComboBox:hover {
    border-color: @ACCENT@;
}

QComboBox:disabled {
    color: rgba(255, 255, 255, 0.3);
}

QComboBox::drop-down {
    border: none;
    width: 26px;
}

QComboBox::down-arrow {
    image: url(@ASSETS@/arrow.svg);
    width: 12px;
    height: 12px;
    margin-right: 10px;
}

QComboBox QAbstractItemView {
    background: @POPUP@;
    color: @TEXT@;
    border: 1px solid @CARD_BORDER@;
    border-radius: 8px;
    padding: 4px;
    outline: none;
    selection-background-color: @ACCENT_DARK@;
    selection-color: white;
}

/* ---------- Sliders: track, filled part, knob ---------- */
/* The knob (16px) is taller than the track (6px). Without a minimum height the slider
   is only as tall as the track needs, and the top of the knob gets cut off. */
QSlider:horizontal {
    min-height: 24px;
}

QSlider::groove:horizontal {
    height: 6px;
    background: rgba(255, 255, 255, 0.13);
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @ACCENT_DARK@, stop:1 @ACCENT@);
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -5px 0;
    background: #ffffff;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background: @ACCENT@;
}

QSlider::sub-page:horizontal:disabled {
    background: rgba(255, 255, 255, 0.2);
}

QSlider::handle:horizontal:disabled {
    background: rgba(255, 255, 255, 0.35);
}

/* ---------- Tick boxes ---------- */
QCheckBox {
    color: @TEXT@;
    font-size: 14px;
    spacing: 9px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 5px;
    background: @INPUT@;
}

QCheckBox::indicator:hover {
    border-color: @ACCENT@;
}

QCheckBox::indicator:checked {
    background: @ACCENT@;
    border-color: @ACCENT@;
}

QCheckBox:disabled {
    color: rgba(255, 255, 255, 0.3);
}
